ENVIRONMENT=development

EDGE_CONFIG=

# LLM provider (swap point: lib/chat/provider.ts)
OPENAI_API_KEY=

# Cloudflare — Workers AI (embeddings) and Vectorize (vector store).
# API token needs Workers AI: Read and Vectorize: Edit.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
VECTORIZE_INDEX_NAME=danielkong-cv

# Upstash Redis — rate limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile — bot protection
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Tunable limits (optional; defaults shown)
CHAT_RATE_LIMIT_PER_IP=10
CHAT_RATE_LIMIT_GLOBAL_DAILY=500
